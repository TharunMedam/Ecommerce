{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {"api/store.js": {"includeFiles": "api/catalog-preview.json", "maxDuration": 30}},
  "rewrites": [{"source":"/api/:path*","destination":"/api/store?route=:path*"}],
  "headers": [{"source": "/(.*)", "headers": [{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"DENY"}]}]
}
